# =============================================================================
# RAGNART global ignore rules (config/ragignore)
# =============================================================================
# Global exclusion rules for the NAS crawl. They apply under every crawled root
# and have the LOWEST precedence: any .ragignore inside the crawled tree can
# override them. This is the analogue of git's core.excludesFile.
#
# Syntax is gitignore (https://git-scm.com/docs/gitignore):
#   - Blank lines and lines starting with '#' are ignored. Write '\#' for a literal '#'.
#   - A leading '!' re-includes a path matched by an earlier pattern.
#   - A trailing '/' matches directories only.
#   - A pattern with no '/' other than a trailing one matches at any depth.
#   - A leading or middle '/' anchors the pattern to the directory of this file.
#   - '*', '?', '[...]' and '**' behave as in gitignore.
#
# Role split: ragnart.yaml holds inclusion rules (include_extensions).
# This file holds exclusion rules only.
#
# This file is LIVE and global. For rules that apply to one directory only, copy
# config/ragignore.example as `.ragignore` into that directory. The example is an
# inert template: every line in it is commented out.

# --- Directories (trailing '/', match at any depth) ----------------------------

# Python virtualenv
.Gin-AI-python-3.12/
# pre-2026-11-01 venv (machine-local interpreter)
.Gin-AI-python-3.12.old/
# uv-managed Python interpreters on NFS (the venv's base)
.uv-python/
# any virtualenv's installed packages, whatever the venv is called
site-packages/
# tool caches (uv archives, etc.)
.cache/
__pycache__/
.git/
node_modules/
.claude/
# ~/.claude is symlinked here (NFS-hosted); the real on-disk dirname differs from ".claude/"
dot.claude-Linux/
.vscode/
.venv/
# macOS stuff
Library/
Applications/
# HuggingFace model cache: READMEs and licenses, not RAG content
LLMs-cache/
# garbage
Downloads/
# multi-component path: matches this exact segment sequence at any depth
# IRM/DRM-encrypted old PPTs, unrecoverable
**/Microsoft--flotel/Documents/

# --- Directory name suffixes (pip package metadata) -----------------------------

# pip package metadata directories
*.dist-info/

# --- File name patterns (each rule says what it matches) ------------------------

# Synology NAS streaming metadata. Matches anywhere in the name.
*@synoeastream*
# macOS AppleDouble resource-fork sidecars (e.g. ._foo.pptx). Only a LEADING "._" is
# excluded, so a mid-name "._" (e.g. Geoffrey_A._Moore_-_Crossing_the_Chasm.pdf) is
# admitted. No slash, so like any gitignore pattern without one this matches the
# basename at any depth, and a directory whose name starts with "._" is excluded
# together with its contents.
._*
# Microsoft Office lock/temp files (e.g. ~$foo.pptx). Only a LEADING "~$" is excluded,
# so a mid-name "~$" (e.g. a~$b.txt) is admitted. Same matching as above: any depth,
# and a directory whose name starts with "~$" is excluded together with its contents.
~$*
