[Unit]
Description=RAGNART NAS ingestion run (scan, reconcile and submit to the ingestion API; snapshot)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=florian
Environment=HOME=/home/florian
ExecStart=/mnt/nfs/Florian/Gin-AI/projects/RAGNART/scripts/ragnart-ingest-run.sh
SyslogIdentifier=ragnart-ingest
StandardOutput=journal
StandardError=journal
# 2-hour hard cap — kills a stuck ingestion so the next timer slot fires cleanly.
TimeoutStartSec=7200
# Exits 75 (EXIT_LOCK_HELD) when another run holds the NAS-ingestion lock (rag.nas_ingest.lock). That is a
# skipped slot, not a failure, so systemd treats it as success and the timer's next slot runs normally.
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
