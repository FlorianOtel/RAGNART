[Unit]
Description=RAGNART search service (GET /v1/search, GET /health)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=florian
WorkingDirectory=/mnt/nfs/Florian/Gin-AI/projects/RAGNART
Environment=HOME=/home/florian
ExecStart=/home/florian/Gin-AI/.Gin-AI-python-3.12/bin/uvicorn ragnart.service:app --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
